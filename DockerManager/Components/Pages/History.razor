@page "/history"
@rendermode InteractiveServer

@using System.Net
@using System.Text.Json
@using DockerManager.Data
@using DockerManager.Models
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Historia logów</PageTitle>

<h3>Historia sprawdzania logów</h3>

@if (isLoading)
{
    <p>Ładowanie historii...</p>
}
else if (historyEntries.Count == 0)
{
    <p>Nie ma jeszcze zapisanych sprawdzeń logów.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Data i godzina</th>
                <th>Sprawdzone kontenery</th>
                <th>Filtry</th>
                <th>Akcja</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in historyEntries)
            {
                <tr>
                    <td>@entry.CheckedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>
                        @foreach (var container in GetContainerNames(entry.ContainersJson))
                        {
                            <div>@container</div>
                        }
                    </td>
                    <td>
                        @foreach (var filter in GetFilters(entry.Filters))
                        {
                            <span style="@($"{GetFilterStyle(filter)} margin-right: 6px;")"
                                  class="log-filter-chip">@filter.Text</span>
                        }

                        @if (GetFilters(entry.Filters).Count == 0)
                        {
                            <span>Brak filtrów</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-primary"
                                @onclick="() => ShowHistoryLogs(entry)">
                            Podgląd logów
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (selectedEntry != null)
{
    <section class="mt-4">
        
        <button class="btn btn-secondary mb-3"
                @onclick="CloseHistoryLogs">
            Zamknij podgląd
        </button>

        <pre style="white-space: pre-wrap; overflow-wrap: anywhere;">@((MarkupString)HighlightLogs(
    selectedEntry.LogsText,
    GetFilters(selectedEntry.Filters)))</pre>
    </section>
}

@code {
    private List<LogCheckHistory> historyEntries = new();
    private LogCheckHistory? selectedEntry;
    private bool isLoading = true;

    private class SavedFilter
    {
        public string Text { get; set; } = "";
        public string BackgroundColor { get; set; } = "";
        public string TextColor { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            historyEntries = await db.LogCheckHistories
                .AsNoTracking()
                .OrderByDescending(entry => entry.CheckedAt)
                .ToListAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private static List<string> GetContainerNames(string containersJson)
    {
        try
        {
            using var document = JsonDocument.Parse(containersJson);

            if (document.RootElement.ValueKind != JsonValueKind.Array)
                return new List<string>();

            var names = new List<string>();

            foreach (var container in document.RootElement.EnumerateArray())
            {
                if (container.ValueKind == JsonValueKind.Object &&
                    container.TryGetProperty("Name", out var name))
                {
                    names.Add(name.GetString() ?? "Nieznany kontener");
                }
                else if (container.ValueKind == JsonValueKind.String)
                {
                    names.Add(container.GetString() ?? "Nieznany kontener");
                }
            }

            return names;
        }
        catch (JsonException)
        {
            return new List<string> { "Nie udało się odczytać danych kontenerów" };
        }
    }
    private static List<SavedFilter> GetFilters(string filters)
    {
        try
        {
            return JsonSerializer.Deserialize<List<SavedFilter>>(filters)
                   ?? new List<SavedFilter>();
        }
        catch (JsonException)
        {
            return new List<SavedFilter>();
        }
    }

    private static string GetFilterStyle(SavedFilter filter)
    {
        return $"background-color:{filter.BackgroundColor};" +
               $"color:{filter.TextColor};";
    }

    private static string HighlightLogs(string text, List<SavedFilter> filters)
    {
        if (string.IsNullOrEmpty(text) || filters.Count == 0)
            return WebUtility.HtmlEncode(text);

        var result = new System.Text.StringBuilder();
        int position = 0;

        while (position < text.Length)
        {
            var match = filters
                .Where(f => !string.IsNullOrEmpty(f.Text))
                .Select(f => new
                {
                    Filter = f,
                    Index = text.IndexOf(
                        f.Text,
                        position,
                        StringComparison.OrdinalIgnoreCase)
                })
                .Where(x => x.Index >= 0)
                .OrderBy(x => x.Index)
                .FirstOrDefault();

            if (match == null)
            {
                result.Append(WebUtility.HtmlEncode(text[position..]));
                break;
            }

            result.Append(WebUtility.HtmlEncode(
                text[position..match.Index]));

            string originalText = text.Substring(
                match.Index, match.Filter.Text.Length);

            result.Append(
                $"<span style=\"background-color:{match.Filter.BackgroundColor};" +
                $"color:{match.Filter.TextColor};\">" +
                WebUtility.HtmlEncode(originalText) +
                "</span>");

            position = match.Index + match.Filter.Text.Length;
        }

        return result.ToString();
    }

    private void ShowHistoryLogs(LogCheckHistory entry)
    {
        selectedEntry = entry;

    }

    private void CloseHistoryLogs()
    {
        selectedEntry = null;
    }
}
