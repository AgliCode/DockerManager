@page "/"
@using DockerManager.Services
@using Docker.DotNet
@using Docker.DotNet.Models
@using DockerManager.Models
@using System.Linq;

@rendermode InteractiveServer

//nasłuchiwanie na bieżąco
@inject IDockerClient DockerClient
@implements IDisposable
@inject ContainerMonitorService ContainerMonitor

//baza danych
@using DockerManager.Data
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject IDbContextFactory<AppDbContext> DbFactory

@using Microsoft.AspNetCore.Components.Web

<PageTitle>Home</PageTitle>
<div class="command-center">
    <h4 class="section-title">Lista kontenerów</h4>

    @if (containers == null)
    {
        <p class="status-message">Ładowanie zasobów Dockera...</p>
    }
    else if (!containers.Any())
    {
        <p class="status-message">Brak aktywnych kontenerów w systemie.</p>
    }
    else
    {
        <div class="container-list">
            @foreach (var c in containers)
            {
                <div class="container-item" @key="c.ID">
                    <input type="checkbox" 
                           class="styled-checkbox"
                           checked="@selectedContainerIds.Contains(c.ID)"
                           @onchange="(e) => ToggleContainer(c.ID, e)" />
                     <div class="container-info">
                        <span class="info-badge">ID: @c.ID.Substring(0, 12)</span>
                        <span class="info-name">@string.Join(", ", c.Names).Replace("/", "")</span>
                        <span class="status-pill @c.State.ToLower()">@c.State</span>
                    </div>
                </div>
            
            }
        </div>
    
    }
    <h4 class="section-title">Wybrane kontenery</h4>
    @if (containers == null)
    {
        <p class="status-message">Ładowanie zasobów Dockera...</p>
    }
    else if (!selectedContainerIds.Any())
    {
        <p class="status-message">Nie wybrano żadnego kontenera operacyjnego.</p>
    }
    else
    {
        <div class="selected-grid">
            @foreach (var c in containers.Where(
                c => selectedContainerIds.Contains(c.ID)))
            {
                <div class="selected-item">
                    <strong>
                        @string.Join(", ", c.Names).Replace("/", "")
                    </strong>
                    <small>ID: @c.ID.Substring(0, 12)</small>

                </div>
            }
        </div>

        <p class="counter-text">Wybrano: <strong>@selectedContainerIds.Count</strong></p>

        //Filtry
        <div class="log-search">
            <label for="log-filter-input" class="form-label">
                Filtruj logi
            </label>

            <div class="input-group">
                <input id="log-filter-input"
                       class="form-control"
                       placeholder="Wpisz słowo lub frazę i naciśnij Enter..."
                       @bind="newFilterText"
                       @bind:event="oninput"
                       @onkeydown="HandleFilterKeyDown" />

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="AddFilter">
                    Dodaj
                </button>
            </div>

            @if (searchFilters.Count > 0)
            {
                <div class="log-filter-list">
                    @foreach (var filter in searchFilters)
                    {
                        <span class="log-filter-chip"
                              style="background-color: @filter.BackgroundColor;
                            color: @filter.TextColor;">

                            @filter.Text

                            <button type="button"
                                    class="log-filter-remove"
                                    style="color: @filter.TextColor;"
                                    aria-label="@($"Usuń filtr {filter.Text}")"
                                    @onclick="() => RemoveFilter(filter)">
                                ×
                            </button>
                        </span>
                    }
                </div>
            }
        </div>

        //Przycisk pokaż
        <div class="action-bar">
            <button class="btn-primary"
                    @onclick="ShowLogsAsync"
                    disabled="@(selectedContainerIds.Count == 0)">
                Pokaż logi
            </button>
        </div>

        @if (isLoadingLogs)
        {
            <p>Pobieranie logów...</p>
        }
        else if (!string.IsNullOrEmpty(logsText))
        {
            <div class="logs-container">
                <pre class="logs-output">@((MarkupString)string.Join(
                "\n",
                (string.IsNullOrEmpty(displayedLogsText)
                    ? logsText
                    : displayedLogsText)
                .Split('\n')
                .Select(line => HighlightMatches(line).Value)))</pre>
            </div>
        }
    }

</div>


@code {
    private IList<ContainerListResponse>? containers;
    private HashSet<string> selectedContainerIds = new();

    private string logsText = "";
    private bool isLoadingLogs = false;


    //Logika filtrów
    private string newFilterText = "";
    private List<SearchFilter> searchFilters = new();
    private string displayedLogsText = "";
    private readonly string[] filterBackgroundColors =
    {
    "#FCE7A8", // żółty
    "#D9E9FF", // niebieski
    "#D9F4DF", // zielony
    "#F7D9F0", // różowy
    "#FFDCC7", // pomarańczowy
    "#E6DDFB"  // fioletowy
};

    private readonly string[] filterTextColors =
    {
    "#684B00",
    "#174A8B",
    "#17632A",
    "#84245F",
    "#873B12",
    "#50318A"
};

    private void HandleFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddFilter();
        }
    }

    private void AddFilter()
    {
        string text = newFilterText.Trim();

        if (string.IsNullOrWhiteSpace(text))
            return;

        if (searchFilters.Any(f =>
            string.Equals(
                f.Text,
                text,
                StringComparison.OrdinalIgnoreCase)))
        {
            newFilterText = "";
            return;
        }

        int colorIndex = searchFilters.Count % filterBackgroundColors.Length;

        searchFilters.Add(new SearchFilter
        {
            Text = text,
            BackgroundColor = filterBackgroundColors[colorIndex],
            TextColor = filterTextColors[colorIndex]
        });

        newFilterText = "";
    }

    private void RemoveFilter(SearchFilter filter)
    {
        searchFilters.Remove(filter);
    }

    private class SearchFilter
    {
        public string Text { get; set; } = "";
        public string BackgroundColor { get; set; } = "";
        public string TextColor { get; set; } = "";
    }

    //Sprawdzenie, czy pojedynczy log ma któryś z filtrów 
    private bool MatchesFilters(string logText)
    {
        // Brak filtrów oznacza wyświetlenie wszystkich logów.
        if (searchFilters.Count == 0)
            return true;

        return searchFilters.Any(filter =>
            logText.Contains(
                filter.Text,
                StringComparison.OrdinalIgnoreCase));
    }

    //Jesli jakies słowo pasuje do filtra -> zmienia sie jego kolor na ten z filtra
    private MarkupString HighlightMatches(string text)
    {
        var result = new System.Text.StringBuilder();
        int position = 0;

        while (position < text.Length)
        {
            var match = searchFilters
                .Where(f => !string.IsNullOrEmpty(f.Text))
                .Select(f => new
                {
                    Filter = f,
                    Index = text.IndexOf(
                        f.Text,
                        position,
                        StringComparison.OrdinalIgnoreCase)
                })
                .Where(x => x.Index >= 0)
                .OrderBy(x => x.Index)
                .FirstOrDefault();

            if (match == null)
            {
                result.Append(
                    System.Net.WebUtility.HtmlEncode(text[position..]));
                break;
            }

            result.Append(
                System.Net.WebUtility.HtmlEncode(
                    text[position..match.Index]));

            result.Append(
                $"<span style=\"background-color:{match.Filter.BackgroundColor};" +
                $"color:{match.Filter.TextColor};\">" +
                System.Net.WebUtility.HtmlEncode(text.Substring(match.Index, match.Filter.Text.Length)) +
                "</span>");

            position = match.Index + match.Filter.Text.Length;
        }

        return new MarkupString(result.ToString());
    }


    //Działanie aplikacji
    protected override async Task OnInitializedAsync()
    {
        ContainerMonitor.ContainersChanged += OnContainersChanged;
        try
        {
            containers = await DockerClient.Containers.ListContainersAsync(new ContainersListParameters
            {
                All = true
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            containers = new List<ContainerListResponse>();
        }
    }

    private Task ToggleContainer(string id, ChangeEventArgs e)
    {
        bool isChecked = Convert.ToBoolean(e.Value);
        if (isChecked)
        {
            selectedContainerIds.Add(id);
        }
        else
        {
            selectedContainerIds.Remove(id);
        }
        logsText = "";
        return Task.CompletedTask;

    }

    private async Task ShowLogsAsync()
    {
        if (containers == null || selectedContainerIds.Count == 0)
            return;

        isLoadingLogs = true;
        logsText = "";
        StateHasChanged();

        //Wybrane kontenery
        var checkedContainers = containers
        .Where(c => selectedContainerIds.Contains(c.ID))
        .Select(c => new
        {
            Name = string.Join(", ", c.Names).Replace("/", ""),
            Id = c.ID
        })
        .ToList();

        try
        {
            var result = new System.Text.StringBuilder();
            var filteredResult = new System.Text.StringBuilder();

            foreach (var c in containers.Where(
                c => selectedContainerIds.Contains(c.ID)))
            {
                string name = string.Join(", ", c.Names)
                    .Replace("/", "");

                result.AppendLine(
                    $"========== {name} ==========");
                result.AppendLine($"ID: {c.ID.Substring(0, 12)}");
                result.AppendLine();

                try
                {
                    var parameters = new ContainerLogsParameters
                    {
                        ShowStdout = true,
                        ShowStderr = true,
                        Timestamps = true,
                        Follow = false,
                    };

                    using var stream =
                        await DockerClient.Containers.GetContainerLogsAsync(
                            c.ID,
                            false,
                            parameters
                        );

                    var (stdout, stderr) =
                        await stream.ReadOutputToEndAsync(
                            CancellationToken.None
                        );

                    if (!string.IsNullOrWhiteSpace(stdout))
                        result.AppendLine(stdout);

                    if (!string.IsNullOrWhiteSpace(stderr))
                        result.AppendLine(stderr);

                    var containerLogText = string.Join(
                        Environment.NewLine,
                        new[] { stdout, stderr }
                            .Where(text => !string.IsNullOrWhiteSpace(text))
                    );

                    var matchingLines = containerLogText
                        .Split(new[] { "\r\n", "\n" },
                            StringSplitOptions.None)
                        .Where(line => MatchesFilters(line))
                        .ToList();

                    filteredResult.AppendLine(
                    $"========== {name} ==========");
                    filteredResult.AppendLine($"ID: {c.ID.Substring(0, 12)}");

                    if (matchingLines.Count > 0)
                    {
                        foreach (var line in matchingLines)
                        {
                            filteredResult.AppendLine(line);
                        }
                    }
                    else if (searchFilters.Count > 0)
                    {
                        filteredResult.AppendLine(
                            "Z tego kontenera nic nie pasowało do filtrów.");
                    }
                    else
                    {
                        filteredResult.AppendLine("Brak logów do wyświetlenia.");
                    }

                    filteredResult.AppendLine();


                    if (string.IsNullOrWhiteSpace(stdout) &&
                        string.IsNullOrWhiteSpace(stderr))
                    {
                        result.AppendLine(
                            "Brak logów do wyświetlenia."
                        );
                    }
                }
                catch (Exception ex)
                {
                    result.AppendLine(
                        $"Błąd pobierania logów: {ex.Message}"
                    );
                }

                result.AppendLine();
            }

            logsText = result.ToString();
            displayedLogsText = filteredResult.ToString();

            if (string.IsNullOrWhiteSpace(displayedLogsText))
            {
                displayedLogsText = searchFilters.Count > 0
                    ? "Brak logów pasujących do podanych filtrów."
                    : "";
            }
        }
        catch (Exception ex)
        {
            logsText = $"Wystąpił błąd: {ex.Message}";
        }
        finally
        {
            //Zapisanie danych do bazy danych
            try
            {
                await using var db =
                    await DbFactory.CreateDbContextAsync();

                var historyEntry = new DockerManager.Models.LogCheckHistory
                {
                    CheckedAt = DateTime.Now,
                    ContainersJson = JsonSerializer.Serialize(
                        checkedContainers
                    ),
                    LogsText = displayedLogsText,
                    Filters = JsonSerializer.Serialize(searchFilters)
                };

                db.LogCheckHistories.Add(historyEntry);
                await db.SaveChangesAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    $"Błąd zapisu historii: {ex.Message}"
                );
            }
            isLoadingLogs = false;
            StateHasChanged();
        }
    }


    private void OnContainersChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshContainersAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshContainersAsync()
    {
        var updatedContainers =
            await DockerClient.Containers.ListContainersAsync(
                new ContainersListParameters
                {
                    All = true
                });

        containers = updatedContainers;
        var existingIds = containers
            .Select(c => c.ID)
            .ToHashSet();

        selectedContainerIds.RemoveWhere(
            id => !existingIds.Contains(id));
    }
    public void Dispose()
    {
        ContainerMonitor.ContainersChanged -= OnContainersChanged;
    }
}